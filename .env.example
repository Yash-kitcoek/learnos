# Supabase — get these from your project's API settings
# https://app.supabase.com/project/<your-project>/settings/api

NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Note: SUPABASE_SERVICE_ROLE_KEY is used server-side ONLY.
# It is never exposed to the browser.
# Never commit your actual .env.local file.
